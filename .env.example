# Скопируйте в .env.local для локальной разработки.
# В проде (Netlify) эти же имена задаются в Site settings → Environment variables.
# Секреты (Service Role, SMTP, Resend) — только на сервере, никогда с префиксом NEXT_PUBLIC_.

# --- Supabase (обязательно) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — секрет, только для сервера (warehouse:backfill, cron, admin-запросы)
SUPABASE_SERVICE_ROLE_KEY=

# --- Приложение (обязательно) ---
# Публичный адрес задеплоенного сайта на Netlify
NEXT_PUBLIC_APP_URL=https://your-app.netlify.app

# --- Cron (обязательно для автообновления Склада) ---
# Секрет для /api/cron/warehouse-sync?secret=...
CRON_SECRET=

# --- Email (один из вариантов, опционально) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# либо SMTP:
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- WhatsApp (опционально) ---
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# --- Внутреннее (опционально) ---
INTERNAL_API_SECRET=

# Telegram, Nova Poshta, Viber, LiqPay токены хранятся в настройках CRM
# в базе данных (per-business), а не в переменных окружения — см. INTEGRATIONS_REQUIRED.md
